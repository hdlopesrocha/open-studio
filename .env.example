# ── Open Studio configuration ─────────────────────────────────────────────
# Copy to .env (make init does this and generates a random INTERNAL_TOKEN).
# Everything has a sensible default; change only what you need.

# Published web app. Only this port is exposed by default.
OPENSTUDIO_PORT=8090
# Loopback-only gateway port for API clients and debugging.
GATEWAY_PORT=8091
OPENSTUDIO_VERSION=1.0.0
TZ=UTC
LOG_LEVEL=INFO

# Absolute host paths are required by the on-demand service manager.
# `make init` rewrites these for you.
OPENSTUDIO_DATA_DIR=./data
OPENSTUDIO_REPO_DIR=.
# Host UID/GID used by the music engine bind mount; make init fills these.
OPENSTUDIO_UID=1000
OPENSTUDIO_GID=1000
# Set by make up-gpu / make up-vulkan to include a compose override when the
# service manager builds a component.
COMPOSE_OVERRIDES=

# Shared secret injected by the gateway into private services. Generate one:
#   openssl rand -hex 32
INTERNAL_TOKEN=change-me-openstudio-internal

# First-run password policy (the password itself is set in the UI, never here).
SESSION_COOKIE=os_session
SESSION_COOKIE_SECURE=false
SESSION_DAYS=30
MIN_PASSWORD_LENGTH=8
LOGIN_ATTEMPTS_PER_MINUTE=8
# Set to true when serving over HTTPS through a reverse proxy.
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# ── LLM (lyrics + video planner) ─────────────────────────────────────────
# Start the bundled Ollama; pull a model with: make models-llm
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=10m
# Or point at any OpenAI-compatible endpoint (llama.cpp, vLLM, LM Studio).
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300

# ── Image generation ─────────────────────────────────────────────────────
# auto | procedural | diffusers | comfyui | qvac
IMAGEGEN_DEFAULT_PROVIDER=auto
# Set to 0 to build a much smaller image without torch/diffusers.
IMAGEGEN_INSTALL_DIFFUSERS=1
# External ComfyUI (optional). Use host.docker.internal from containers.
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=

# ── Music / ACE-Step 1.5 ─────────────────────────────────────────────────
ACESTEP_DEVICE=CPU
ACESTEP_DOWNLOAD_MODELS=true
ACESTEP_LM_SIZE=0.6B
ACESTEP_QUANT=Q8_0
ACESTEP_DIT_VARIANT=turbo
ACESTEP_KEEP_LOADED=false
ACESTEP_VULKAN=0
ACESTEP_EXTRA_ARGS=

# ── Voice / TTS ──────────────────────────────────────────────────────────
VOICE_DEVICE=cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.8.0
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_ASR_MODEL=openai/whisper-large-v3-turbo
OMNIVOICE_LOAD_ASR=0
DEFAULT_PIPER_VOICE=pt-PT-tugao
VOICE_MAX_UPLOAD_MB=50

# ── Subtitles ────────────────────────────────────────────────────────────
WHISPER_DEVICE=auto
SRT_INSTALL_CUDA=0

# ── QVAC ─────────────────────────────────────────────────────────────────
# cpu | gpu. QVAC video needs roughly 16 GB VRAM / 20 GB unified memory.
QVAC_DEVICE=cpu
# 1 generates short placeholder clips without a model (useful for demos).
QVAC_MOCK=0

# ── Per-component job concurrency ────────────────────────────────────────
MUSIC_CONCURRENCY=1
VIDEO_CONCURRENCY=2
VOICE_CONCURRENCY=1
SRT_CONCURRENCY=1
IMAGEGEN_CONCURRENCY=1
TRANSLATION_CONCURRENCY=2
SUMMARY_CONCURRENCY=1
DOCS_CONCURRENCY=2
FFMPEG_CONCURRENCY=2
YTDLP_CONCURRENCY=2
QVAC_CONCURRENCY=1
LLM_CONCURRENCY=2
VIDEO_MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=86400

# ── Text / PDF ───────────────────────────────────────────────────────────
CPU_THREADS=4
MODEL_IDLE_UNLOAD_SECONDS=900
PDF_OCR_LANGUAGES=eng+por
GATEWAY_MAX_TEXT_CHARS=500000

# ── Misc ─────────────────────────────────────────────────────────────────
ENABLE_DOCS=0
OLLAMA_VERSION=latest
